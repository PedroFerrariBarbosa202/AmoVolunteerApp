<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VolunteerApp.Pages.SecondPage"
             Title=""
             BackgroundColor="{AppThemeBinding Dark=#262626, Light=#e0d7d7}">


    <Grid x:Name="ContentGrid">
        <Grid RowSpacing="12" ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        
            <ScrollView>
                <VerticalStackLayout x:Name="EventStackLayout" Grid.Row="1" Padding="10"/>
            </ScrollView>
        </Grid>
    </Grid>


</ContentPage>
