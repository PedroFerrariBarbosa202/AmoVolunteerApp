<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VolunteerApp.Pages.ManagePage"
             BackgroundColor="{AppThemeBinding Dark=#262626, Light=#e0d7d7}">

    <ScrollView>
        <Grid>
            <Label x:Name="LoadLabel" Grid.Row="0" HorizontalOptions="Center" FontSize="20" TextColor="{AppThemeBinding Dark=White, Light=Black}">Carregando...</Label>
            <VerticalStackLayout x:Name="EventStackLayout" Padding="10">
                <!-- Events added dynamically -->
            </VerticalStackLayout>
        </Grid>
    </ScrollView>


</ContentPage>
