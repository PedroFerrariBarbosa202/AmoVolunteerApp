<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VolunteerApp.Cards.SectorDetailCard">
    
    <VerticalStackLayout>
        <Border
            StrokeShape="RoundRectangle 20"
            BackgroundColor="#2A2A2A"
            Padding="20">

            <Border.Shadow>
                <Shadow Brush="Black"
                        Opacity="0.4"
                        Radius="10"
                        Offset="0,4"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="15">
                <HorizontalStackLayout Spacing="15">

                    <VerticalStackLayout VerticalOptions="Center">
                        <Label x:Name="TitleLabel"
                               Text="Kitchen"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White"/>

                        <Label x:Name="DescriptionLabel"
                               Text="Food preparation and meal organization"
                               FontSize="14"
                               TextColor="#BBBBBB"/>
                    </VerticalStackLayout>

                </HorizontalStackLayout>

                <!-- Divider -->
                <BoxView x:Name="DividerLine"
                         HeightRequest="1"
                         BackgroundColor="#3A3A3A"/>

                <HorizontalStackLayout HorizontalOptions="End">

                    <Button Text="Ver Detalhes"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="40"
                            Padding="20,0"
                            Clicked="OnEnterSectorDetailsClicked"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>